# ===========================================================================
# The KK Factor - server configuration
#
# Copy this file to `.env` and fill in the blanks. `.env` is gitignored and
# must never be committed.
#
#     cp .env.example .env
# ===========================================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB) -----------------------------------------------------
# Must name the database, or the driver silently uses "test":
#   ...mongodb.net/kk_factor?retryWrites=true&w=majority
#
# Some home connections refuse the DNS lookup the +srv form needs and fail
# with "querySrv EREFUSED". If that happens, use the long form from Atlas
# (Connect -> Drivers -> "Node.js 2.2.12 or later"), which lists the cluster
# machines directly. On a real host, prefer +srv.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kk_factor?retryWrites=true&w=majority

# --- Authentication ---------------------------------------------------------
# Two different long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5
MAX_AUDIO_SIZE_MB=25

# Set this on any host with an ephemeral disk (Render's free plan wipes it on
# every restart). With it, uploads go to Cloudinary and survive; without it
# they go to local disk, which is what you want on a laptop.
# CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME

# --- CORS allow-list (comma-separate for several origins) -------------------
FRONTEND_URL=http://localhost:5173

# Used in the ready-made "we are live" social post.
PUBLIC_SITE_URL=http://localhost:5173

# --- Community news ---------------------------------------------------------
NEWS_FEED_URL=https://greekcitytimes.com/feed/
NEWS_SOURCE_NAME=Greek City Times

# LEAVE THIS false unless the publisher has given written permission.
# false = headline, photo, short excerpt and a link back to their site.
# true  = the whole article stored and shown here, which needs their consent.
#
# Permission for the TEXT is not automatically permission for the PHOTOGRAPHS.
# Newsrooms routinely run agency pictures licensed for their own site alone.
# Worth settling separately, in the same email.
NEWS_FULL_TEXT=false

# The importer prefers the publisher's WordPress API over their RSS feed:
# real photo URLs instead of scraping each page for an og:image, the sections
# a story was filed under, the author, and pages going back years instead of
# the latest fifteen. Left blank it is worked out from NEWS_FEED_URL's host.
# NEWS_API_URL=https://greekcitytimes.com/wp-json/wp/v2
NEWS_USE_API=true

# Which of the publisher's sections to take, by their own category id.
# Empty means all of them - for Greek City Times that is a great deal of wire
# copy about Turkey and the United States, which buries the Greek and
# Greek-Australian stories this audience tuned in for.
#
#   npm run news:categories      lists them with counts and suggests a set
#
# NEWS_CATEGORY_IDS=106,95442,108,132,122,114082,117784

# Stories per refresh, and how many pages of them. One page is the routine
# refresh. Raise NEWS_IMPORT_PAGES temporarily to pull in a back catalogue,
# then put it back to 1.
NEWS_IMPORT_LIMIT=30
NEWS_IMPORT_PAGES=1

# --- The show (YouTube) -----------------------------------------------------
# The channel's public Atom feed. No API key, no quota. A finished live stream
# becomes an ordinary video, so it appears in the archive on its own.
YOUTUBE_CHANNEL_ID=UC2g-gkU4Hwc3tGd3hkv5E1Q

# --- Email reminders --------------------------------------------------------
# One message to listeners about an hour before the show. Leave these blank
# and the feature switches itself off: the sign-up box does not appear, the
# countdown and the "add to calendar" button carry on as normal, and nothing
# else on the site notices.
#
# Any SMTP provider works, which is the point of using SMTP rather than one
# vendor's API. Free tiers that are plenty for a weekly send:
#   Brevo    smtp-relay.brevo.com:587    300 messages a day
#   Resend   smtp.resend.com:587         3,000 a month
#
# MAIL_FROM must be an address the provider has verified for you. A message
# claiming to come from an address the sending server has no right to use
# lands in spam, when it is accepted at all.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=The KK Factor <no-reply@thekkfactor.com.au>

# --- Feed refresh -----------------------------------------------------------
# The in-process timer only runs while the service is awake, and a free host
# sleeps. So point an outside scheduler (cron-job.org) at:
#
#   POST https://YOUR-SITE/api/import/run
#   header:  x-import-secret: <IMPORT_SECRET>
#
# The weekly reminder email rides along with that same call, so there is only
# ever one scheduled job to set up and only one to forget.
#
IMPORT_INTERVAL_MINUTES=30
IMPORT_SECRET=

# --- Seed account created by: npm run db:seed -------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
